<section class="file-panel media-preview" id="audioPreview" aria-label="Audio player" hidden>
  <div class="audio-heading">
    <img id="albumCover" alt="Embedded album artwork" hidden />
    <div><h2 id="trackTitle"></h2><p id="trackArtist"></p></div>
  </div>
  <audio id="audioPlayer" controls preload="metadata"></audio>
  <div class="player-options">
    <label for="playbackSpeed">Speed <output id="speedValue">1.00×</output></label>
    <input id="playbackSpeed" type="range" min="0.25" max="3" step="0.05" value="1" />
    <button type="button" class="link-button" id="resetSpeed">[ reset ]</button>
    <label><input id="preservePitch" type="checkbox" checked /> Preserve pitch</label>
  </div>
  <canvas id="audioWaveform" width="1000" height="140" tabindex="0" role="slider" aria-label="Audio waveform: seek with arrow keys" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" hidden></canvas>
  <p id="waveformStatus" class="file-status" role="status">Waveform will load when audio information is ready.</p>
  <p class="file-status" id="audioError" role="status"></p>
</section>
<section class="file-panel media-preview" id="imagePreview" aria-label="Image preview" hidden>
  <img id="previewImage" alt="" decoding="async" />
  <p id="imageError" class="file-status" role="status"></p>
</section>
<section class="file-panel media-preview" id="videoPreview" aria-label="Video player" hidden>
  <video id="videoPlayer" controls preload="metadata" playsinline></video>
</section>
<%- include('../../pdf/viewer.ejs') %>

<%- include ('./partials/header.ejs') %>
<div class="container">
  <div class="center-container">
    <h1>
      welcome to <span class="blue"><%= webname %></span
      ><img src="public/emojis/miku_leek.png" class="emoji" />
    </h1>
    <div class="paragraph-container">
      <p align="left">
        This is essentially a file sharing service, for me and a couple friends.
      </p>
      <p align="left">
        Right now, it's
        <span class="green">an invite-only</span> service, if you want to use
        it, contact me at
        <a href="https://specifix.dev/" target="_blank">my website</a>
        and give a good reason.
      </p>
      <p align="left">
        I'll probably consider it!
        <span class="nobreak deviate">⸜(｡˃ ᵕ ˂ )⸝♡</span>
      </p>
      <p class="footnote" align="right">
        <%= build_date %> v<%= project_version %>
      </p>
    </div>

    <form id="uploadForm" enctype="multipart/form-data">
      <!-- Access key -->
      <input
        type="password"
        id="key"
        name="key"
        placeholder="Enter access key (the one i gave you)"
        required
      />
      <div class="upload-mode" aria-label="Upload mode">
        <button type="button" class="link-button" id="textMode" aria-pressed="false">[ text mode ]</button>
        <button type="button" class="link-button" id="fileMode" aria-pressed="true">[ file mode ]</button>
      </div>

      <!-- File picker -->
      <div class="upload-source" id="fileSource">
      <div class="uploader" id="uploader" role="button" aria-label="Add files" tabindex="0">
        <svg aria-hidden="true" width="24" height="24" viewBox="0 0 24 24">
          <path
            fill="currentColor"
            d="M4 20q-.825 0-1.412-.587T2 18V6q0-.825.588-1.412T4 4h6l2 2h8q.825 0 1.413.588T22 8v10q0 .825-.587 1.413T20 20z"
          />
        </svg>
        <div class="uploader-text">
          <strong>Drop files here</strong> or
          <span class="blue underline">browse</span>
          <div class="hint">Max per file <%= max_size %> MB (<%= max_temp_size %> MB temporary). Total up to <%= max_batch_size %> MB; <%= max_files %> files.</div>
        </div>
        <input type="file" id="file" name="file" multiple hidden />
      </div>
      <div id="fileName" aria-live="polite"></div>
      <div class="file-table" id="selectedFiles" role="table" aria-label="Selected files"></div>
      </div>
      <div class="text-source" id="textSource" hidden>
        <textarea id="pasteContent" rows="12" aria-label="Text content" placeholder="Paste or write text here..."></textarea>
        <p id="textSummary" role="status" aria-live="polite"></p>
        <div id="textProgress" class="file-table"></div>
      </div>

      <div class="upload-options">
      <div class="optionContainer collection-options" id="collectionOptions">
        <label title="Share one folder link"><input type="checkbox" id="collectionCheck" /> Collection</label>
        <input type="text" id="collectionName" placeholder="Collection name" maxlength="150" hidden />
      </div>
      <div class="optionContainer paste-title-option" id="pasteTitleOption" hidden>
        <label for="pasteTitle">Title</label>
        <input type="text" id="pasteTitle" placeholder="untitled" maxlength="150" />
      </div>

      <!-- Temporary option -->
      <div class="optionContainer">
        <label id="temporaryLabel">
          <input type="checkbox" id="temporaryCheck" />
          Temporary File
        </label>

        <select id="durationSelect" name="duration" disabled>
          <option value="" disabled selected>Select duration</option>
          <option value="1h">1 hour</option>
          <option value="2h">2 hours</option>
          <option value="24h">24 hours</option>
          <option value="48h">48 hours</option>
          <option value="7d">7 days</option>
        </select>
      </div>
      </div>

      <div id="uploadFeedback" class="upload-feedback" hidden>
      <p id="output" class="hide" role="status" aria-live="polite"></p>

      <div id="collectionResult" class="file-table"></div>
      <div class="file-table" id="uploadResults" aria-live="polite" role="table" aria-label="Uploaded files"></div>
      </div>

      <!-- Submit -->
      <button id="uploadButton" type="submit" disabled>Upload</button>
    </form>

    <div class="flex-list">
      <div class="oomf">
        <img
          src="public/miku_approved.gif"
          width="88"
          height="31"
          loading="lazy"
          alt="MIKU APPROVED WEBSITE!!!!"
        />
        <img
          src="/public/hatsunelol.png"
          width="88"
          height="31"
          loading="lazy"
          alt="hatsune.lol"
        />
      </div>
      <img class="big" src="public/miku_ascii.png" />
    </div>
  </div>
</div>
<%- include ('./partials/footer.ejs') %>
